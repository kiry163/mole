# Instance secrets for mole: copy to ~/.mole/.env (next to config.json) and
# chmod 600. This is a plain KEY=VALUE file, not a shell script: values are
# loaded verbatim, config.json references them as whole `$VAR` values, and a
# `$VAR` the config uses but this file does not define is a load error.
# Changes apply on the next start of the gateway.

# ── Process environment ───────────────────
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
TZ=Asia/Shanghai

# ── Console ───────────────────────────────
# Console access token (the credential of /setup and /login). Leave empty to
# run /setup and have the console generate one, or set your own value here.
# config.json keeps "dashboard": {"token": "$DASHBOARD_TOKEN"}.
DASHBOARD_TOKEN=

# ── Chat channels ─────────────────────────
# Referenced by channel_list.<name>.settings in config.json, e.g.
# "app_secret": "$QQ_APP_SECRET". Secrets are never stored in config.json itself.
QQ_APP_SECRET=

# ── LLM providers ─────────────────────────
# Referenced by model_list entries: "api_keys": ["$DEEPSEEK_API_KEY"],
# "api_base": "$DEEPSEEK_BASE_URL". Every provider entry can use its own names.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ── Web search (optional) ─────────────────
# Referenced by tools.web.tavily.api_keys in config.json.
TAVILY_API_KEY=

# ── Bootstrap variables ───────────────────
# MOLE_HOME, MOLE_CONFIG and MOLE_BUILTIN_SKILLS are read from the process
# environment before this file is loaded, so they do not belong here:
#   MOLE_HOME=/root/.mole
#   MOLE_CONFIG=/root/.mole/config.json
