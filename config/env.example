# Instance secrets for mole. Copy to ~/.mole/.env (next to config.json) and
# chmod 600. Values are plain variables; config.json references them as whole
# values, e.g. "api_keys": ["$DEEPSEEK_API_KEY"].

PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
TZ=Asia/Shanghai

# Console access token. Leave empty to use /setup, or set a value here.
DASHBOARD_TOKEN=
TELEGRAM_TOKEN=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
